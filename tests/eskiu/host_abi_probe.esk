// Host-only Eskiu ABI smoke probe.
// This file intentionally avoids Viro renderer classes. It proves only the C ABI seam.

struct ViroEskiuPose {
    float px;
    float py;
    float pz;
    float qx;
    float qy;
    float qz;
    float qw;
}

extern int viro_cpp_accumulate(int base, int delta);

int viro_eskiu_contract_version() {
    return 1;
}

ViroEskiuPose viro_eskiu_pose_identity() {
    return ViroEskiuPose {
        px: 0.0,
        py: 0.0,
        pz: 0.0,
        qx: 0.0,
        qy: 0.0,
        qz: 0.0,
        qw: 1.0
    };
}

float viro_eskiu_pose_position_sum(ViroEskiuPose pose) {
    return pose.px + pose.py + pose.pz;
}

int viro_eskiu_call_cpp(int base, int delta) {
    return viro_cpp_accumulate(base, delta);
}
