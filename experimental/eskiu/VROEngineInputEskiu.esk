// Runtime-capable Eskiu implementation of the Viro v0.1 input ring contract.
//
// The producer/consumer indices are 32-bit atomic cells because Eskiu v0.9.2's
// <atomic> intrinsics operate on int. They are interpreted as wrapping uint32
// sequence counters, so subtraction remains valid across wrap as long as
// capacity stays below 2^31.
//
// SPSC memory ordering:
// - producer writes the sample, then release-stores write_index;
// - consumer acquire-loads write_index before reading the sample;
// - consumer release-stores read_index after consuming the sample;
// - producer acquire-loads read_index before reusing the slot.

import <mem>;
import <atomic>;

struct ViroEskiuInputSample {
    uint32 struct_size;
    uint32 kind;
    uint64 sequence;
    uint64 timestamp_ns;
    uint64 frame_id;
    uint32 source_id;
    uint32 flags;
    uint8[56] payload;
}

struct ViroEskiuInputRing {
    uint32 capacity;
    int write_index;
    int read_index;
    int dropped_count;
    *ViroEskiuInputSample samples;
}

*void viro_eskiu_input_ring_create(uint32 capacity) {
    if (capacity == 0 || capacity > 2147483647) {
        return null;
    }

    *ViroEskiuInputRing ring = alloc<ViroEskiuInputRing>(1);
    if (ring == null) {
        return null;
    }

    ring.capacity = capacity;
    ring.samples = alloc<ViroEskiuInputSample>(capacity);
    if (ring.samples == null) {
        free(ring);
        return null;
    }

    atomic_store(&ring.write_index, 0);
    atomic_store(&ring.read_index, 0);
    atomic_store(&ring.dropped_count, 0);
    return (*void)ring;
}

void viro_eskiu_input_ring_destroy(*void opaque) {
    if (opaque == null) {
        return;
    }
    *ViroEskiuInputRing ring = (ViroEskiuInputRing*)opaque;
    free(ring.samples);
    free(ring);
}

uint32 viro_eskiu_input_ring_capacity(*void opaque) {
    if (opaque == null) {
        return 0;
    }
    *ViroEskiuInputRing ring = (ViroEskiuInputRing*)opaque;
    return ring.capacity;
}

uint32 viro_eskiu_input_ring_size(*void opaque) {
    if (opaque == null) {
        return 0;
    }
    *ViroEskiuInputRing ring = (ViroEskiuInputRing*)opaque;
    uint32 write = (uint32)atomic_load(&ring.write_index);
    uint32 read = (uint32)atomic_load(&ring.read_index);
    return write - read;
}

uint64 viro_eskiu_input_ring_dropped_count(*void opaque) {
    if (opaque == null) {
        return 0;
    }
    *ViroEskiuInputRing ring = (ViroEskiuInputRing*)opaque;
    int dropped = atomic_load(&ring.dropped_count);
    if (dropped < 0) {
        return 2147483647;
    }
    return (uint64)dropped;
}

int viro_eskiu_input_ring_push(*void opaque, *ViroEskiuInputSample sample) {
    if (opaque == null || sample == null ||
        sample.struct_size < 96 || sample.kind > 4) {
        return 3;
    }

    *ViroEskiuInputRing ring = (ViroEskiuInputRing*)opaque;
    uint32 write = (uint32)atomic_load(&ring.write_index);
    uint32 read = (uint32)atomic_load(&ring.read_index);

    if (write - read >= ring.capacity) {
        int dropped = atomic_load(&ring.dropped_count);
        if (dropped < 2147483647) {
            atomic_store(&ring.dropped_count, dropped + 1);
        }
        return 2;
    }

    uint32 index = write % ring.capacity;
    ring.samples[index] = *sample;
    ring.samples[index].struct_size = 96;
    atomic_store(&ring.write_index, (int)(write + 1));
    return 0;
}

int viro_eskiu_input_ring_pop(*void opaque, *ViroEskiuInputSample out_sample) {
    if (opaque == null || out_sample == null || out_sample.struct_size < 96) {
        return 3;
    }

    *ViroEskiuInputRing ring = (ViroEskiuInputRing*)opaque;
    uint32 read = (uint32)atomic_load(&ring.read_index);
    uint32 write = (uint32)atomic_load(&ring.write_index);

    if (read == write) {
        return 1;
    }

    uint32 index = read % ring.capacity;
    *out_sample = ring.samples[index];
    out_sample.struct_size = 96;
    atomic_store(&ring.read_index, (int)(read + 1));
    return 0;
}
